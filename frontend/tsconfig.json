{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true, "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true, "composite": true, "tsBuildInfoFile": "../node_modules/.tmp/frontend.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"], "references": []
}

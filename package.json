{
  "name": "platypus-starfire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --workspace frontend run dev",
    "dev:api": "npm --workspace backend run dev",
    "build": "npm run typecheck && npm --workspace frontend run build && npm --workspace backend run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "start:api": "npm --workspace backend run start",
    "preview": "npm --workspace frontend run preview"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
